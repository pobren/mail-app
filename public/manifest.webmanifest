{
	"name": "Mail App",
	"short_name": "Mail App",
	"description": "Your own email, on your own Cloudflare account.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#ffffff",
	"theme_color": "#c8102e",
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "New email", "url": "/compose", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Inbox", "url": "/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
	],
	"protocol_handlers": [
		{ "protocol": "mailto", "url": "/compose?mailto=%s" }
	]
}
