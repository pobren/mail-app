{
	"name": "mail-app",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"cloudflare": {
		"label": "Mail App",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI",
			"Email Routing"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain, such as `example.com`. Mail App gets the email for it. After deploying, follow the steps in the README to switch on Email Routing and sign-in."
			},
			"POLICY_AUD": {
				"description": "Leave this as it is for now. You'll set it after deploying, when you switch on Cloudflare Access (see the README)."
			},
			"TEAM_DOMAIN": {
				"description": "Leave this as it is for now. You'll set it after deploying, when you switch on Cloudflare Access (see the README)."
			}
		}
	},
	"scripts": {
		"build": "node --max-old-space-size=6144 node_modules/@react-router/dev/bin.js build",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
		"dev": "react-router dev",
		"dev:local": "LOCAL_ONLY=1 react-router dev",
		"test": "node --experimental-strip-types --test test/*.test.ts installer/test/*.test.ts",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"package": "node --experimental-strip-types installer/package.ts"
	},
